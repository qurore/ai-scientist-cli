{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"", "timeout": 30, "statusMessage": "Checking AI Scientist environment"}]
    }],
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [
        {"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard_experiment_exec.py\"", "timeout": 30},
        {"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_decision_log.py\"", "timeout": 30},
        {"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_bibcheck.py\"", "timeout": 30},
        {"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_citations.py\"", "timeout": 60}
      ]
    }],
    "PostToolUse": [{
      "matcher": "Bash",
      "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/log_tool_use.py\"", "timeout": 30}]
    }],
    "Stop": [{
      "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_autopilot.py\"", "timeout": 30}]
    }]
  }
}
